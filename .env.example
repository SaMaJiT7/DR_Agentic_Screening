# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must never be committed.

# --- LLM (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# --- Detector ---
# Path to the bundle produced by the training notebook.
DR_MODEL_PATH=dr_svm_bundle.joblib
T_SEVERE=0.30
T_REFERABLE=0.50

# --- Knowledge bases (optional overrides) ---
# STAGE_KB_PATH=agents/data/stage_kb.json
# CARE_KB_PATH=agents/data/care_kb.json
# COST_KB_PATH=agents/data/cost_kb.json

# --- Hospital search (OpenStreetMap Nominatim) ---
# NOMINATIM_USER_AGENT=dr-screening-agent/0.1 (portfolio project)
# HOSPITAL_LIMIT=8
# HTTP_TIMEOUT=15
